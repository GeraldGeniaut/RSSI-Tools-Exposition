# =============================================================================
#  /etc/exposition/exposition.ini — SERVEUR DE COLLECTE
#  Propriétaire root:exposition, droits 640 (lisible par le compte de service,
#  modifiable par root seulement). Voir docs/03-installation-serveur.md
# =============================================================================

[general]
# Domaine de l'établissement (obligatoire)
domain    = example.org
# État interne (ce qui a déjà été vu / acquitté)
state_dir = /var/lib/exposition

[hudsonrock]
# Identifiants du domaine dans des logs d'infostealers (API gratuite)
enabled = true

[ransomwarelive]
# Revendications sur les sites de fuite des groupes de rançongiciels (API gratuite)
enabled  = true
# Mots-clés recherchés en MOT ENTIER (« etab » ne déclenche pas sur « etablissement »).
# Nom court de l'établissement, sigle, tutelle, principaux prestataires.
# Évitez les mots trop courts ou trop courants (faux positifs).
keywords = monetablissement, mon-sigle

[certfr]
# Alertes et avis du CERT-FR (flux RSS) qui citent un produit de VOTRE parc
enabled = true
days    = 30
keywords = Fortinet, FortiOS, FortiGate, FortiClient, VMware, vCenter, ESXi,
           Veeam, GLPI, Centreon, Wazuh, Graylog, Tomcat, MariaDB, MySQL,
           Apache HTTP, Nginx, HAProxy, OpenSSH, WordPress, PHP, Nextcloud,
           Microsoft Entra, Active Directory

[shodan]
# Ports et CVE connus sur vos IP publiques (Shodan InternetDB, sans clé)
enabled = true
# Plages CIDR et/ou adresses, séparées par des virgules (1024 adresses max par plage)
ips = 203.0.113.0/24

[ct]
# Certificate Transparency (crt.sh, sans clé) : noms certifiés pour le domaine.
# Nouveau nom, ou nom certifié par une nouvelle autorité = nouveauté.
enabled = true

[sosies]
# Domaines ressemblants (typosquatting) : ~170 variantes testées via DNS-over-HTTPS.
enabled = true
# Variantes qui vous appartiennent ou sans danger (ex. example.com, example.eu)
ignore =
# Extensions testées pour le nom exact (avec et sans tiret)
tlds = fr, com, net, org, eu, info, online, site, xyz, co, io, me, app
# Mots accolés au nom : monetab-connexion.fr, connexion-monetab.fr…
words = etudiant, etudiants, connexion, login, securite, portail, mail, support
# Variantes supplémentaires à surveiller
extra =
# Résolveur DNS-over-HTTPS (format JSON)
doh = https://cloudflare-dns.com/dns-query

[rbl]
# Listes noires DNS. Requêtes via le résolveur DNS du système : Spamhaus REFUSE les
# résolveurs publics (Quad9, Cloudflare, Google). Testez d'abord : voir docs/02-sources.md
enabled = true
ip_lists     = zen.spamhaus.org, bl.spamcop.net, b.barracudacentral.org
domain_lists = dbl.spamhaus.org
# IP à vérifier : vide = celles de [shodan]
ips =
# Domaines à vérifier (vide = [general] domain)
domains = example.org

[abuseipdb]
# Vos IP signalées comme sources d'attaques. Clé GRATUITE (abuseipdb.com > Account > API).
# Laisser vide pour désactiver.
api_key =
# Plages à vérifier (par /24, un appel chacune) : vide = celles de [shodan]
networks =
max_age_days = 30
# Score de confiance AbuseIPDB (%) à partir duquel le signalement est critique
crit_score = 50

[abusech]
# URLhaus (URL de distribution de malware) et ThreatFox (indicateurs de compromission).
# Auth-Key GRATUITE commune (auth.abuse.ch). Laisser vide pour désactiver.
auth_key =
domains = example.org
# IP interrogées une à une : sorties NAT, relais de messagerie… (pas tout le bloc)
ips = 203.0.113.10, 203.0.113.20

[hibp]
# OPTION PAYANTE — Have I Been Pwned, recherche par domaine.
# Laisser vide pour désactiver. Voir docs/05-option-hibp.md
api_key =

[server]
# Dossier du rapport publié (exposition.html + exposition.json)
out_dir = /var/lib/exposition/www

# Copie directe du rapport par scp (optionnel, laisser vide sinon).
# Méthodes recommandées : voir docs/06-publication-web.md
scp_target =
scp_key    =

# Envoi par mail — voir docs/07-envoi-mail.md
mail_to       = rssi@example.org
mail_from     = exposition@example.org
smtp_host     = relais-smtp.example.internal
smtp_port     = 25
smtp_starttls = false
